@startuml
mainframe  Baseline System

participant "Legacy Device\n(IoT Sensor)" as Device
participant "Edge Gateway" as Gateway
participant "Cloud Service" as Cloud

Gateway -> Cloud: negotiateSession(Legacy RSA)
activate Gateway
activate Cloud
Cloud --> Gateway: sessionEstablished
deactivate Cloud
deactivate Gateway

Device -> Device: generateData()
activate Device

Device -> Device: encryptData(AES)
activate Device
deactivate Device

Device -> Gateway: sendData(EncryptedPayload)
activate Gateway

Gateway -> Gateway: decryptData(LegacyKey)
activate Gateway
deactivate Gateway

Gateway -> Gateway: reEncryptData(CloudKey)
activate Gateway
deactivate Gateway

Gateway -> Cloud: forwardData(ReEncryptedPayload)
activate Cloud

Cloud -> Cloud: decryptData()
activate Cloud
deactivate Cloud

Cloud -> Cloud: storeData()
activate Cloud
deactivate Cloud

Cloud --> Gateway: status
deactivate Cloud

Gateway --> Device: status
deactivate Gateway
deactivate Device

@enduml
