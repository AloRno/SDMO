@startuml
mainframe CD Phase 0 Baseline System

class LegacyDevice {
  - pre_shared_key: Bytes
  - data_buffer : List
  + generateData(): String
  + encryptData(data: String): Bytes
  + sendData(encrypted_data: Bytes): void
}

class EdgeGateway {
  - pre_shared_key: Bytes
  - p
  - g 
  - sh_private_key
  - dh_public_key
  - shared_secret
  - cloud_aes_key
  + negotiateSession(cloud_service : Cloud Service): void
  + receiveData(legacy_device : LegacyDevice): Bytes
  + decryptData(encryptedData : Bytes): String
  + reEncryptData(plaintext : String): Bytes
  + forwardData(cloud_service : CloudService, reEncryptedData : Bytes): void
}

class CloudService {
  - session_keys: Map<String, Bytes>
  - data_storage: List<String>
  + handleSessionNegotiation(): void
  + receiveData(encryptedPayload: Bytes): void
  + decryptData(encryptedPayload: Bytes): String
  + storeData(payload: String): void
}

LegacyDevice "1" --> "1" EdgeGateway
EdgeGateway "1" --> "1" CloudService : Secure TLS Tunnel

@enduml
