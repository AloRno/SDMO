@startuml
mainframe Current Simulation State

participant "Legacy Device\n(IoT Sensor)" as Device
participant "Edge Gateway" as Gateway
participant "Cloud Service" as Cloud

Gateway -> Gateway: generate DH keys (A, a)
activate Gateway
Gateway -> Cloud: negotiateSession(Gateway DH Public Key 'A')
activate Cloud
Cloud -> Cloud: generate DH keys (B, b)
Cloud -> Cloud: derive shared secret (A^b mod p)
Cloud -> Cloud: generate AES Key from secret
Cloud --> Gateway: Cloud DH Public Key 'B'
deactivate Cloud
Gateway -> Gateway: derive shared secret (B^a mod p)
Gateway -> Gateway: generate AES Key from secret


Device -> Device: generateData()
activate Device

Device -> Device: encryptData(Hard-coded AES key)


Device -> Gateway: sendData(EncryptedPayload)


Gateway -> Gateway: pop buffer & decryptData(Legacy AES Key)


Gateway -> Gateway: reEncryptData(DH Derived AES Key)


Gateway -> Cloud: forwardData(ReEncryptedPayload)
activate Cloud

Cloud -> Cloud: decryptData(DH Derived AES Key)


Cloud -> Cloud: processData()


Cloud --> Gateway: Return / None
deactivate Cloud

Gateway --> Device: Return / None
deactivate Gateway
deactivate Device

@enduml
