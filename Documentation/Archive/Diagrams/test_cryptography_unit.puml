@startuml test_cryptography_unit
participant "Legacy Sensor" as LS
participant "Network Buffer" as B
participant "Edge Gateway" as EG

LS -> LS: Generate Data
LS -> LS: Encrypt Data (Legacy AES-CBC)
LS -> B: Send Encrypted Data
EG -> B: Retrieve Encrypted Data
EG -> EG: Decrypt Data (Legacy AES-CBC)

note over LS, EG: Assertion: Decrypted Data == Original Data
@enduml
