@startuml
mainframe CD Phase 0 Baseline System

class LegacyDevice {
  - pre_shared_key: Bytes
  - data_buffer : List
  + generateData(): String
  + encryptData(data: String): Bytes
  + sendData(encrypted_data: Bytes): void
}

class EdgeGateway {
  - pre_shared_key : Bytes
  - p : Integer
  - g : Integer
  - dh_private_key : Integer
  - dh_public_key : Integer
  - shared_secret : Integer
  - cloud_aes_key : Bytes
  + negotiateSession(cloud_service : CloudService) : void
  + receiveData(legacy_device : LegacyDevice) : Bytes
  + decryptData(encryptedData : Bytes) : String
  + reEncryptData(plaintext : String) : Bytes
  + forwardData(cloud_service : CloudService, reEncryptedData : Bytes) : void
}

class CloudService {
  - p : Integer
  - g : Integer
  - dh_private_key : Integer
  - dh_public_key : Integer
  - shared_secret : Integer
  - aes_key : Bytes
  - incoming_buffer : List
  + negotiate_dh(gatewaypublic_key : Integer) : Integer
  + receiveData(encrypted_data : Bytes) : void
  + processData() : String
}

LegacyDevice "1" --> "1" EdgeGateway
EdgeGateway "1" --> "1" CloudService : Secure TLS Tunnel

@enduml
