diff --git a/docker-compose.yml b/docker-compose.yml
new file mode 100644
index 0000000..c226cff
--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,20 @@
+services:
+  sdmo-app:
+    build: .
+    ports:
+      - "8000:8000"
+    healthcheck:
+      test: ["CMD", "curl", "-f", "http://localhost:8000/metrics"]
+      interval: 10s
+      timeout: 5s
+      retries: 3
+      start_period: 5s
+
+  prometheus:
+    image: prom/prometheus:latest
+    ports:
+      - "9090:9090"
+    volumes:
+      - ./prometheus.yml:/etc/prometheus/prometheus.yml
+    depends_on:
+      - sdmo-app
diff --git a/prometheus.yml b/prometheus.yml
new file mode 100644
index 0000000..d098d80
--- /dev/null
+++ b/prometheus.yml
@@ -0,0 +1,7 @@
+global:
+  scrape_interval: 5s
+
+scrape_configs:
+  - job_name: 'sdmo-app'
+    static_configs:
+      - targets: ['sdmo-app:8000']
