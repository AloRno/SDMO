diff --git a/Documentation/Archive/Diagrams/container_interaction.puml b/Documentation/Archive/Diagrams/container_interaction.puml
new file mode 100644
index 0000000..e38973f
--- /dev/null
+++ b/Documentation/Archive/Diagrams/container_interaction.puml
@@ -0,0 +1,37 @@
+@startuml
+skinparam componentStyle rectangle
+skinparam handwritten false
+skinparam backgroundColor #FFFFFF
+
+actor "User Browser" as User
+
+
+
+
+
+        
+        node "Container: sdmo-app" {
+            component "Python Daemon (Port 8000)" as App
+            component "Sensor Thread" as Sensor
+            component "Gateway Thread" as Gateway
+            component "Cloud Thread" as Cloud
+            
+            Sensor -> Gateway : Telemetry
+            Gateway -> Cloud : Encrypted Data
+            Cloud .> App : Updates Metrics
+        }
+        
+        node "Container: prometheus" {
+            component "Prometheus Server (Port 9090)" as Prom
+            database "Prometheus DB" as DB
+            
+            Prom -> DB : Stores Metrics
+        }
+        
+        Prom --> App : HTTP GET /metrics\n(Scrape every 5s)
+
+
+
+User --> Prom : HTTP GET localhost:9090\n(View Dashboard)
+
+@enduml
\ No newline at end of file
